# ---------------------------------------------------------------------------
# Argus frontend build-time config.
# Copy this file to .env.local for local dev, and set the same keys in the
# Vercel project settings for production. Vite only exposes vars prefixed with
# VITE_ to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the Argus backend (FastAPI, hosted separately on Koyeb).
# Local dev:   http://localhost:8000
# Production:  https://<your-app>.koyeb.app   (no trailing slash)
VITE_API_URL=http://localhost:8000

# Optional. When set, Settings shows a "Source code" link pointing here.
# Left blank the link is simply not rendered.
VITE_REPO_URL=
