# ===================================================================
# Argus backend environment. Copy to .env and fill in real values.
# NEVER commit the real .env (it is gitignored).
# ===================================================================

# ---- Core ----
APP_ENV=development
# Supabase Postgres connection string.
# Supabase dashboard > Project Settings > Database > Connection string > URI.
# Include ?sslmode=require. Direct connection (port 5432) or session pooler both work.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
# The frontend origin allowed by CORS. In prod this is your Vercel URL.
ALLOWED_ORIGIN=http://localhost:5173

# ---- LLM providers ----
# Google AI Studio: https://aistudio.google.com/apikey  (free)
GEMINI_API_KEY=
# Groq (fallback): https://console.groq.com/keys  (free)
GROQ_API_KEY=
# Conservative daily Gemini call ceiling before falling back to Groq.
LLM_DAILY_BUDGET=200

# ---- Email (SMTP, e.g. Gmail App Password) ----
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below (not your
# normal password). Sends to any recipient the user sets on a watcher.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_NAME=Argus Mission Control
# Optional default recipient (demo fleet / fallback when a watcher has none).
OWNER_EMAIL=you@example.com

# ---- WhatsApp channel (optional, via CallMeBot) ----
# Free, no signup. From your WhatsApp, message the CallMeBot number
# (+34 644 51 95 23) with: I allow callmebot to send me messages
# It replies with an apikey bound to your number. Fill both to turn the
# channel on; leave blank to keep alerts email-only.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=

# ---- Scheduler ----
# Argus keeps its own time: a loop inside the app checks the database for due
# watchers every SCHEDULER_INTERVAL_SECONDS, so a watcher runs within about a
# minute of when it was scheduled. All the process needs is to be awake, which
# on a free host means pointing an uptime monitor at /health.
# Set SCHEDULER_ENABLED=false to go back to being driven only by POST /tick.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
# Any long random string. Still required for POST /tick, which remains a manual
# trigger and a fallback if you would rather drive it from outside.
TICK_SECRET=change-me-to-a-long-random-string
MAX_RUNS_PER_TICK=5
MAX_ACTIVE_WATCHERS=25

# ---- Accounts ----
# REQUIRED in production. Signs session tokens and password reset links.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Changing it signs everyone out and voids outstanding reset links.
SECRET_KEY=
# Where the verify / reset links in emails point: the FRONTEND, not this API.
# Production: https://<your-app>.vercel.app   (no trailing slash)
FRONTEND_BASE_URL=http://localhost:5173
# How long a signed-in session lasts, and how long a new account may go
# unconfirmed before it has to verify. The grace period exists so someone can
# try the app immediately instead of being sent to their inbox first.
SESSION_DAYS=30
VERIFY_GRACE_HOURS=24
RESET_TOKEN_HOURS=1
# Optional. Created once on first boot so watchers that predate accounts have
# an owner who can sign in. Leave the password blank to create nothing.
SEED_ACCOUNT_EMAIL=
SEED_ACCOUNT_PASSWORD=

# ---- Demo ----
# Seed and keep a demo fleet alive so the deployed site looks active.
DEMO_MODE=true
DEMO_CYCLE_MINUTES=20
# Public URL of THIS backend once deployed (used for the demo target link).
PUBLIC_BASE_URL=http://localhost:8000
